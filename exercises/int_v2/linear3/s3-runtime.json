{
  "target": "bmv2",
  "p4info": "build/int_md.p4.p4info.txtpb",
  "bmv2_json": "build/int_md.json",
  "table_entries": [
    {
      "table": "MyIngress.process_int_source_sink.tb_set_sink",
      "match": { "standard_metadata.egress_port": 2 }, 
      "action_name": "MyIngress.process_int_source_sink.int_set_sink",
      "action_params": {}
    },
     {
      "table": "MyIngress.l3_forward.ipv4_lpm",
      "match": { "hdr.ipv4.dst_addr": ["10.0.3.3", 32] },
      "action_name": "MyIngress.l3_forward.ipv4_forward",
      "action_params": {
          "dstAddr": "08:00:00:00:03:33",
          "srcAddr": "08:00:00:00:03:00",
          "port": 2
       }
    },
    {
      "table": "MyIngress.l3_forward.ipv4_lpm",
      "match": { "hdr.ipv4.dst_addr": ["10.0.4.4", 32] },
      "action_name": "MyIngress.l3_forward.ipv4_forward",
      "action_params": {
          "dstAddr": "08:00:00:00:04:44",
          "srcAddr": "08:00:00:00:04:00",
          "port": 3
       }
    },
    {
      "table": "MyEgress.process_int_transit.tb_int_insert",
      "default_action": true,
      "action_name": "MyEgress.process_int_transit.init_metadata",
      "action_params": { "node_id": 3 }
    },
    {
      "table": "MyEgress.process_int_report.tb_generate_report",
      "default_action": true,
      "action_name": "MyEgress.process_int_report.do_report_encapsulation",
      "action_params": {
          "src_mac": "08:00:00:00:04:00",
          "mon_mac": "08:00:00:00:04:44",
          "src_ip": "10.0.4.40", 
          "mon_ip": "10.0.4.4",
          "src_port": 6666,
          "mon_port": 24576
      }
    }
  ],
  "clone_session_entries": [
    {
      "clone_session_id": 500, 
      "replicas": [
          { "egress_port": 3, "instance": 1 } 
      ]
    }
  ]
}